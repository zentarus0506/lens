# Copy to .env and edit. Never commit the real one.
LENS_PROVIDER=mock
LENS_MODEL=mock-1

# Transport: set to 0 when a sandbox injects a loopback proxy for its own traffic.
LENS_TRUST_ENV=1
# LENS_PROXY=http://127.0.0.1:7890

# Provider keys. Leave blank to reuse keys already stored by other local tools
# (Lens reads opencode's auth.json automatically).
# ZENMUX_API_KEY=
# SILICONFLOW_CN_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# OPENAI_API_KEY=

# Custom OpenAI-compatible endpoint (any name not in the built-in list):
# MYGW_BASE_URL=https://gateway.example.com/v1
# MYGW_API_KEY=
# LENS_PROVIDER=mygw
